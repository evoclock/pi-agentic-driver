---------------------------- MODULE WorkerAbort ----------------------------
\* Generated by bowerbird from Guarded worker abort. Regenerate; do not hand-edit.
\* Guards are abstracted to free booleans chosen each step, so TLC explores
\* both outcomes. Refine a guard by replacing its variable with real state.
VARIABLES state, g1, g2, g3, g4, g5
vars == <<state, g1, g2, g3, g4, g5>>

States == {"guards", "delivered", "worker", "requested", "settled", "refused", "worker-refused"}
Finals == {"settled", "refused", "worker-refused"}
\* g1 : target_current
\* g2 : target_invalid
\* g3 : current_and_queue_safe
\* g4 : invalid_or_queue_pending
\* g5 : cancelled_or_idle

TypeOK == state \in States /\ g1 \in BOOLEAN /\ g2 \in BOOLEAN /\ g3 \in BOOLEAN /\ g4 \in BOOLEAN /\ g5 \in BOOLEAN

Init == state = "guards" /\ g1 \in BOOLEAN /\ g2 \in BOOLEAN /\ g3 \in BOOLEAN /\ g4 \in BOOLEAN /\ g5 \in BOOLEAN

\* guards --validate [target_current] / publish_or_original--> delivered
T1_validate == state = "guards" /\ g1 /\ state' = "delivered" /\ g1' \in BOOLEAN /\ g2' \in BOOLEAN /\ g3' \in BOOLEAN /\ g4' \in BOOLEAN /\ g5' \in BOOLEAN
\* guards --validate [target_invalid] / audit_refusal--> refused
T2_validate == state = "guards" /\ g2 /\ state' = "refused" /\ g1' \in BOOLEAN /\ g2' \in BOOLEAN /\ g3' \in BOOLEAN /\ g4' \in BOOLEAN /\ g5' \in BOOLEAN
\* delivered --event_loop_yields / watch_or_poll--> worker
T3_event_loop_yields == state = "delivered" /\ state' = "worker" /\ g1' \in BOOLEAN /\ g2' \in BOOLEAN /\ g3' \in BOOLEAN /\ g4' \in BOOLEAN /\ g5' \in BOOLEAN
\* worker --check [current_and_queue_safe] / ack_then_ctx_abort--> requested
T4_check == state = "worker" /\ g3 /\ state' = "requested" /\ g1' \in BOOLEAN /\ g2' \in BOOLEAN /\ g3' \in BOOLEAN /\ g4' \in BOOLEAN /\ g5' \in BOOLEAN
\* worker --check [invalid_or_queue_pending] / ack_refusal--> worker-refused
T5_check == state = "worker" /\ g4 /\ state' = "worker-refused" /\ g1' \in BOOLEAN /\ g2' \in BOOLEAN /\ g3' \in BOOLEAN /\ g4' \in BOOLEAN /\ g5' \in BOOLEAN
\* requested --get_or_read [cancelled_or_idle]--> settled
T6_get_or_read == state = "requested" /\ g5 /\ state' = "settled" /\ g1' \in BOOLEAN /\ g2' \in BOOLEAN /\ g3' \in BOOLEAN /\ g4' \in BOOLEAN /\ g5' \in BOOLEAN

\* Final states stutter so reaching one is not reported as deadlock.
Done == state \in Finals /\ UNCHANGED vars

Next == T1_validate
    \/ T2_validate
    \/ T3_event_loop_yields
    \/ T4_check
    \/ T5_check
    \/ T6_get_or_read
    \/ Done

Spec == Init /\ [][Next]_vars /\ WF_vars(Next)

\* Liveness: every behaviour eventually finishes (fails on cycles with no exit).
EventuallyDone == <>(state \in Finals)
=============================================================================
