{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pad:pad-exit-checks.v1",
  "title": "PAD repository exit-check defaults",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "fromGateRules", "defaults"],
  "properties": {
    "schema": { "const": "pad-exit-checks.v1" },
    "fromGateRules": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/import" }
    },
    "defaults": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/check/properties/id" },
        "kind": { "$ref": "#/$defs/check/properties/kind" },
        "counter": { "$ref": "#/$defs/check/properties/counter" },
        "covers": { "$ref": "#/$defs/check/properties/covers" },
        "timeoutSeconds": { "$ref": "#/$defs/check/properties/timeoutSeconds" }
      },
      "allOf": [
        { "$ref": "#/$defs/check/allOf/0" },
        { "$ref": "#/$defs/check/allOf/1" }
      ]
    },
    "relativeDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[.]|[^./\\\\][^/\\\\]*(?:/[^./\\\\][^/\\\\]*)*)$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["lint", "types", "test", "invariant-test"] },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "prefixItems": [{ "type": "string", "minLength": 1 }]
        },
        "cwd": { "$ref": "#/$defs/relativeDirectory" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600, "default": 120 },
        "counter": { "enum": ["node-tap", "python-unittest", "pytest", "cargo"] },
        "covers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["test", "invariant-test"] } }, "required": ["kind"] },
          "then": { "required": ["counter"] }
        },
        {
          "if": { "properties": { "kind": { "const": "invariant-test" } }, "required": ["kind"] },
          "then": { "required": ["covers"], "properties": { "covers": { "minItems": 1 } } }
        }
      ]
    }
  }
}
