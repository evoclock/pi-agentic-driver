{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pad-design-spec.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "model", "invariants", "features", "stack", "checks"],
  "properties": {
    "schema": { "const": "pad-design-spec.v1" },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["module", "sha256", "view", "viewSha256", "safe", "unsafe"],
      "properties": {
        "module": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha" },
        "view": { "$ref": "#/$defs/path" }, "viewSha256": { "$ref": "#/$defs/sha" },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/pin" }, "uniqueItems": true },
        "safe": { "$ref": "#/$defs/config" },
        "unsafe": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["config", "sha256", "guard", "mustViolate"],
            "properties": {
              "config": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha" },
              "guard": { "$ref": "#/$defs/operator" }, "mustViolate": { "$ref": "#/$defs/operator" }
            }
          }
        }
      }
    },
    "chart": { "$ref": "#/$defs/pin" },
    "invariants": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "statement"],
        "properties": { "id": { "$ref": "#/$defs/operator" }, "statement": { "type": "string", "minLength": 1 } }
      }
    },
    "features": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "stack": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "extra": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "playbook": { "type": "string", "minLength": 1 },
        "harness": { "enum": ["pi", "claude", "codex"] }
      }
    },
    "checks": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "invariantWhen": { "enum": ["g8", "both"], "default": "g8" },
        "add": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/check" } }
      }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "operator": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000\\r\\n]+$" },
    "pin": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha" } }
    },
    "config": {
      "type": "object", "additionalProperties": false, "required": ["config", "sha256"],
      "properties": { "config": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha" } }
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["lint", "types", "test", "invariant-test"] },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "cwd": { "$ref": "#/$defs/path" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "counter": { "enum": ["node-tap", "python-unittest", "pytest", "cargo"] },
        "covers": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/operator" } }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "enum": ["test", "invariant-test"] } } }, "then": { "required": ["counter"] } },
        { "if": { "properties": { "kind": { "const": "invariant-test" } } }, "then": { "required": ["covers"], "properties": { "covers": { "minItems": 1 } } } }
      ]
    }
  }
}
